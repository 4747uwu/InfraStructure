# Sign-in accounts for the server, used once: on the first start with an empty database.
# Only scrypt hashes are stored here; the passwords themselves are not in this repository.
# After the first start, change passwords in the app under Settings - editing this file
# does not change accounts that already exist.
#
# To set different passwords before the first deployment, replace a hash with the output of:
#   cd server && node --input-type=module -e "import {hashPassword} from './src/security.js'; console.log(await hashPassword(process.argv[1]))" "new-password"
# Keep the single quotes: they stop the $ signs being read as variables.

MASTER_USERNAME=master
